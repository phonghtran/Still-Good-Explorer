{
  "name": "app-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "serve": "vite",
    "build": "vite build",
    "lint": "eslint \"src/**/*.{js,vue}\"",
    "lint-fix": " eslint \"src/**/*.{js,vue}\" --fix",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "bootstrap": "^4.6.2",
    "connect-history-api-fallback": "^2.0.0",
    "express": "^4.21.2",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.33.0",
    "sass": "^1.77.0",
    "vite": "^8.3.5"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "es6": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "globals": {
      "Atomics": "readonly",
      "SharedArrayBuffer": "readonly"
    },
    "rules": {
      "no-undef": 0,
      "vue/html-indent": 1,
      "vue/require-v-for-key": 0,
      "vue/require-default-prop": 0,
      "vue/v-bind-style": 0,
      "vue/no-unused-components": 0,
      "vue/attribute-hyphenation": 0,
      "vue/html-self-closing": 0,
      "vue/name-property-casing": 0,
      "vue/require-prop-types": 0,
      "vue/prop-name-casing": 0,
      "semi": 1,
      "vue/attributes-order": 2,
      "vue/multi-word-component-names": 0
    },
    "plugins": [
      "vue"
    ],
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  }
}
